# Production Environment Configuration
# Copy to .env and fill in real values for Render deployment

NODE_ENV=production
PORT=3000

# ==================== REQUIRED: Supabase (PostgreSQL Database) ====================
# Get these from https://supabase.com dashboard
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyxxxxx...

# ==================== REQUIRED: Hugging Face ====================
# Get your API key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_api_key_here

# ==================== Deriv Trading (Broker) ====================
# Get from https://deriv.com/account/api-token
DERIV_APP_ID=your_deriv_app_id
DERIV_TOKEN=your_deriv_auth_token

# ==================== Model Configuration ====================
SEQUENCE_LENGTH=60
BATCH_SIZE=32
TRAINING_EPOCHS=50
VALIDATION_SPLIT=0.2
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# ==================== Risk Management ====================
MIN_SIGNAL_CONFIDENCE=0.60
MAX_POSITION_SIZE=0.10
MAX_DAILY_LOSS=100
STOP_LOSS=0.02
TAKE_PROFIT=0.05

# ==================== Data ====================
HISTORICAL_LOOKBACK=2000
MIN_TRAINING_SAMPLES=100
SENTIMENT_CACHE_TIMEOUT=3600000

# ==================== Logging ====================
DEBUG_MODE=false
LOG_LEVEL=info

